# ローカル用。Cloud Run では同じ名前を環境変数(または Secret Manager)で渡す
DATABASE_URL=sqlite:///./local.db
# Cloud SQL(MySQL)のとき:mysql+pymysql://USER:PASSWORD@/DB?unix_socket=/cloudsql/PROJECT:REGION:INSTANCE
GEMINI_API_KEY=
FIREBASE_PROJECT_ID=uttc-class10-react
CORS_ORIGINS=http://localhost:5173
# 写真の URL の先頭に使う、このバックエンドの公開 URL(本番は https://… を入れる。空ならリクエストの URL を使う)
PUBLIC_BASE_URL=
